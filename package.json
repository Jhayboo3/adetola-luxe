{
  "name": "larkvine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "verify:worker-runtime": "node scripts/verify-worker-runtime.mjs",
    "verify:deps": "node scripts/check-dependency-pins.mjs",
    "prepare:local-d1": "node scripts/prepare-local-d1.mjs",
    "prewarm": "node scripts/prewarm.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
