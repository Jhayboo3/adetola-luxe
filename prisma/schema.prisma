generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  engineType = "client"
  runtime = "cloudflare"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("customer")
  phone     String?
  whatsapp String?
  gender    String?
  address   String?
  state     String?
  city      String?
  zip       String?
  deliveryInfo String?
  measurementUnit String @default("inches")
  measurements String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passwordResetTokens PasswordResetToken[]
  orders Order[]
  checkouts Checkout[]
  stores Store[]
}

model Checkout {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  requestHash String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String
  currency    String   @default("NGN")
  createdAt   DateTime @default(now())
  orders      Order[]

  @@index([userId, createdAt])
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  coverImage String?
  whatsapp  String?
  phone     String?
  email     String?
  description String?
  category  String?
  isVerified Boolean  @default(false)
  country   String?
  state     String?
  city      String?
  area      String?
  physicalAddress String?
  mapLocation String?
  pickupAvailable Boolean @default(false)
  deliveryAvailable Boolean @default(false)
  instagramUrl String?
  preferredContactMethod String?
  aboutStore String?
  productsDescription String?
  openingHours String?
  deliveryAreas String?
  pickupInformation String?
  paymentMethods String?
  returnPolicy String?
  status    String   @default("pending")
  rejectionReason String?
  approvedAt DateTime?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    Product[]
  categories  Category[]
  orders      Order[]
  orderItems  OrderItem[]
  discountCodes DiscountCode[]

  @@index([ownerId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  products    Product[]
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime  @default(now())

  @@index([parentId])
  @@unique([storeId, slug])
}

model Product {
  id         String      @id @default(cuid())
  storeId    String
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  description String
  price      Float
  priceMinor BigInt?
  compareAt  Float?
  compareAtMinor BigInt?
  images     String   @default("[]")
  sizes      String   @default("[]")
  colors     String   @default("[]")
  colorSelectable Boolean @default(true)
  stock      Int         @default(0)
  clothingType String?
  targetGender String @default("Unisex")
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id])
  featured   Boolean     @default(false)
  published  Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId, categoryId])
  @@index([published, createdAt(sort: Desc), id(sort: Desc)], map: "Product_catalog_newest_idx")
  @@index([published, price, id(sort: Desc)], map: "Product_catalog_price_idx")
}

model Order {
  id            String      @id @default(cuid())
  checkoutId    String?
  checkout      Checkout?   @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderCode     String?
  email         String
  name          String
  address       String
  city          String
  state         String
  zip           String
  country       String      @default("NG")
  phone         String?
  whatsapp      String?
  deliveryInfo String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  checkoutToken String?
  gender        String?
  measurementUnit String?
  measurementSnapshot String @default("{}")
  measurementCapturedAt DateTime?
  size          String?
  items         OrderItem[]
  subtotal      Float
  currency      String?
  subtotalMinor BigInt?
  shipping      Float       @default(0)
  shippingMinor BigInt?
  discount      Float?
  discountMinor BigInt?
  total         Float
  totalMinor    BigInt?
  status        String      @default("pending")
  paymentMethod String      @default("manual")
  paymentStatus String      @default("pending")
  vendorContactOpenedAt DateTime?
  acceptedAt    DateTime?
  rejectionReason String?
  reservationExpiresAt DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([checkoutId])
  @@index([storeId])
  @@index([status, reservationExpiresAt])
  @@unique([storeId, orderCode])
  @@unique([storeId, checkoutToken])
}

model OrderItem {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  size      String
  color     String  @default("Default")
  price      Float
  priceMinor BigInt?

  @@index([storeId])
  @@index([productId])
}

model DiscountCode {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code       String
  type       String
  value      Float
  minOrder   Float?
  active     Boolean   @default(true)
  usageLimit Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([storeId, code])
}
