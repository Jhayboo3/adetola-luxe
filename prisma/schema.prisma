generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  engineType = "client"
  runtime = "cloudflare"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("customer")
  phone     String?
  whatsapp String?
  gender    String?
  address   String?
  state     String?
  city      String?
  zip       String?
  deliveryInfo String?
  measurementUnit String @default("inches")
  measurements String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passwordResetTokens PasswordResetToken[]
  orders Order[]
  stores Store[]
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  whatsapp  String?
  phone     String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    Product[]
  categories  Category[]
  orders      Order[]
  orderItems  OrderItem[]
  discountCodes DiscountCode[]

  @@index([ownerId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  products    Product[]
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime  @default(now())

  @@index([parentId])
  @@unique([storeId, slug])
}

model Product {
  id         String      @id @default(cuid())
  storeId    String
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  description String
  price      Float
  compareAt  Float?
  images     String   @default("[]")
  sizes      String   @default("[]")
  colors     String   @default("[]")
  colorSelectable Boolean @default(true)
  stock      Int         @default(0)
  clothingType String?
  targetGender String @default("Unisex")
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id])
  featured   Boolean     @default(false)
  published  Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId, categoryId])
}

model Order {
  id            String      @id @default(cuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderCode     String?
  email         String
  name          String
  address       String
  city          String
  state         String
  zip           String
  country       String      @default("NG")
  phone         String?
  whatsapp      String?
  deliveryInfo String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  checkoutToken String?
  gender        String?
  measurementUnit String?
  measurementSnapshot String @default("{}")
  measurementCapturedAt DateTime?
  size          String?
  items         OrderItem[]
  subtotal      Float
  shipping      Float       @default(0)
  discount      Float?
  total         Float
  status        String      @default("pending")
  paymentMethod String      @default("manual")
  paymentStatus String      @default("pending")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([storeId])
  @@unique([storeId, orderCode])
  @@unique([storeId, checkoutToken])
}

model OrderItem {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  size      String
  color     String  @default("Default")
  price     Float

  @@index([storeId])
}

model DiscountCode {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code       String
  type       String
  value      Float
  minOrder   Float?
  active     Boolean   @default(true)
  usageLimit Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([storeId, code])
}
